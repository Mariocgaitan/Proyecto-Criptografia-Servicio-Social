# .env.production — vive en el EC2 en /home/webservice/app/.env.production
# NO commitear el archivo real; este es solo template.
# Los secretos reales (JWT, SMTP, DB, etc.) vienen de AWS Parameter Store (/feria/prod/*).

# ── Entorno ──────────────────────────────────────────────────────────────────
APP_ENV=production
DEBUG=false
SHOW_DOCS=false

# ── Secrets backend ──────────────────────────────────────────────────────────
# Lee los secretos desde AWS SSM Parameter Store.
# Lightsail no soporta IAM roles, así que usamos IAM User con access keys
# (user: sid-backend-prod, policy: SSM read + KMS decrypt sobre /feria/prod/*).
SECRETS_BACKEND=aws
AWS_SECRETS_PREFIX=/feria/prod/
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME

# ── Dominios permitidos por CORS ─────────────────────────────────────────────
ALLOWED_ORIGINS=["https://feriaserviciosocial.com","https://www.feriaserviciosocial.com"]

# ── SSH tunnel a la DB remota ────────────────────────────────────────────────
USE_SSH_TUNNEL=true
# SSH_PKEY_PATH lo inyecta docker-compose (/app/.ssh/db_tunnel_db_key)

# ── Redis (contenedor local) ─────────────────────────────────────────────────
# IMPORTANTE: cambiar por un password fuerte antes del primer up. Ej.:
#   openssl rand -base64 32
REDIS_PASSWORD=CHANGE_ME_A_STRONG_PASSWORD
# REDIS_URL se arma automáticamente en docker-compose.prod.yml

# ── Workers ──────────────────────────────────────────────────────────────────
# 1 worker por ahora (el SSH tunnel usa puertos fijos y no soporta múltiples forks).
# Subir cuando se mueva el tunnel a un sidecar autossh.
WEB_CONCURRENCY=1

# ── Login / seguridad ────────────────────────────────────────────────────────
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# ── Flags de testing deshabilitados en prod ──────────────────────────────────
TEST_ROLE_SWITCH_ENABLED=false

# ── Path del SSH key (dentro del host del EC2) ───────────────────────────────
# Se monta read-only al contenedor app en /app/.ssh/db_tunnel_db_key
SSH_KEY_HOST_PATH=/home/webservice/.ssh/db_tunnel_db_key

# ── Imagen Docker (se sobrescribe en el deploy) ──────────────────────────────
APP_IMAGE=ghcr.io/mariocgaitan/proyecto-criptografia-servicio-social:latest
