# =========================
# Base de datos
# =========================
DATABASE_URL=postgresql+asyncpg://usuario:password@localhost:5432/sid_db

# =========================
# SSH tunnel (opcional)
# =========================
USE_SSH_TUNNEL=false
SSH_HOST=localhost
SSH_PORT=22
SSH_USER=user
SSH_PKEY_PATH=~/.ssh/id_rsa

REMOTE_DB_HOST=127.0.0.1
REMOTE_DB_PORT=5432
LOCAL_BIND_PORT=5433

# =========================
# JWT y seguridad
# =========================
JWT_SECRET_KEY=cambia_esta_llave_por_una_muy_larga_y_segura_min_32_chars
QR_ENCRYPTION_KEY=pon_aqui_tu_clave_fernet_valida
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_HOURS=8
PRE_AUTH_TOKEN_EXPIRE_MINUTES=10

# =========================
# Google OAuth
# =========================
GOOGLE_CLIENT_ID=tu_google_client_id.apps.googleusercontent.com

# =========================
# SMTP
# =========================
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=usuario_correo
SMTP_PASSWORD=password_correo
SMTP_FROM_EMAIL=notificaciones@serviciosocial.tec.mx

# =========================
# App
# =========================
APP_ENV=development
DEBUG=true
SHOW_DOCS=true

# Role switch (solo pruebas locales)
TEST_ROLE_SWITCH_ENABLED=false
TEST_ROLE_SWITCH_EMAIL=
TEST_ROLE_SWITCH_ROLE=

# CORS (CSV o JSON array)
# Ejemplo CSV:
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
# Ejemplo JSON array (alternativa):
# ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# HTTPS local (mkcert)
USE_HTTPS=false
SSL_CERTFILE=
SSL_KEYFILE=

# Login lockout
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
