# ============================================================
# VARIABLES DE ENTORNO — SID Backend
# Copia este archivo como .env y rellena los valores reales.
# NUNCA subas .env al repositorio.
# ============================================================

# Base de datos (local con Docker Compose)
DATABASE_URL=postgresql+asyncpg://sid_user:sid_password_local@localhost:5432/sid_db

# JWT — Cambia esto por un string aleatorio seguro en producción
# Genera uno con: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=cambia_esto_por_un_string_aleatorio_seguro_de_64_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_HOURS=8

# App
APP_ENV=development
DEBUG=true
